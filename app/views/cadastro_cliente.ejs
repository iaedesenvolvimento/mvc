<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilo.css">
    <title>Cadastro de Clientes</title>
</head>

<body>

    <header>
        <nav id="menu">
            <a href="/">Home</a> |
            <a href="/validarCPF">Verifica CPF</a> |
            <a href="/confirma">Confirma Senha</a>
        </nav>
    </header>

    <main>
        <section id="titulo">
            <h1>Cadastro de Clientes</h1>
        </section>

        <section id="caixa_formulario">
            <!-- Exibir erros -->
            <% if (typeof errors !=='undefined' && errors.length> 0) { %>
                <ul style="color:white;">
                    <% errors.forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }); %>
                </ul>
                <% } %>

                    <form action="/add_cliente" method="post">

                        <div class="campo">
                            <label for="nome">Nome</label>
                            <input type="text" name="nome" value="<%=dadoDigitado.nome || '' %>" id="nome" size="30" maxlength="70" required>
                        </div>

                        <div class="campo">
                            <label for="cpf">CPF</label>
                            <input type="text" name="cpf" id="cpf" value="<%=dadoDigitado.cpf || '' %>" size="11" maxlength="11" required>
                        </div>

                        <div class="campo">
                            <label for="senha">Senha</label>
                            <input type="password" name="senha" id="senha" value="<%=dadoDigitado.senha || '' %>" size="8" maxlength="8" required>
                        </div>

                        <div class="campo">
                            <label for="confirmasenha">Confirma Senha</label>
                            <input type="password" name="confirmasenha" id="confirmasenha" value="<%=dadoDigitado.confirmasenha || '' %>" size="8" maxlength="8" required>
                        </div>

                        <button type="submit">Cadastrar</button>

                    </form>
        </section>
    </main>

</body>

</html>